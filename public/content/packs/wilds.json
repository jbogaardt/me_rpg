  "arcs": {
    "lost_lanterns": {
      "title": "The Lost Lanterns",
      "welcome": [
        "Welcome, travellers.",
        "The lights are going out across {r1}. Find {keeper}, and keep close to one another."
      ],
      "regions": 3,
      "capabilities": { "map": false },
      "chapters": [
        {
          "title": "The Dimming",
          "intro": [
            "You came in from the road? Then you saw the woods go dark behind you.",
            "I am {keeper}. The lights that kept these lands safe are going out, one by one, and the creatures are bolder for it.",
            "Help me, and we will find out who is putting them out."
          ]
        },
        {
          "title": "Into {r2}",
          "narration": ["The road leads on into {r2}. Stay together."],
          "intro": ["The trail leads on into {r2}, by {r1~r2.way}.", "{r1~r2.sign}"]
        },
        {
          "title": "The Mound",
          "narration": ["Ahead, the mound. Whatever puts the lights out is close."],
          "intro": [
            "It all leads to {r3}.",
            "{r2~r3.sign}",
            "Something old is awake there, drinking the light. End it."
          ]
        }
      ],
      "quests": [
        {
          "id": "clear",
          "chapter": 0,
          "learned": "The {r1.common.lower} only came this close once the lights went out.",
          "fieldNote": ["The last one flees into the dark between the trees."],
          "title": "Clear the Camp",
          "goal": "Drive off 5 {r1.common.lower}",
          "hint": "{r1.common.plural} prowl all over {r1}.",
          "where": { "zones": ["@r1"] },
          "unit": "{r1.common.lower}",
          "objective": { "t": "kill", "kind": "@r1.common", "count": 5 },
          "reward": { "gold": 25, "xp": 30 },
          "offer": ["The {r1.common.lower} come right up to the camp now. Drive off five of them."],
          "remind": ["Five {r1.common.lower}, all round {r1}."],
          "done": ["Better. We can breathe again.", "But they will be back while the lights stay dark."]
        },
        {
          "id": "lights",
          "chapter": 0,
          "learned": "The {r1.site.lower} still burn, but weakly, as if something is drinking them.",
          "fieldNote": ["Four lights, and every one of them dimmer than it should be."],
          "title": "Count the Lights",
          "goal": "Touch 4 {r1.site.lower}",
          "hint": "{r1.site.plural} glow here and there in {r1}.",
          "where": { "zones": ["@r1"] },
          "unit": "{r1.site.lower}",
          "objective": { "t": "gather", "site": "@r1.site", "zone": "@r1", "count": 4 },
          "reward": { "gold": 30, "xp": 40, "items": ["potion"] },
          "offer": ["Touch four of the {r1.site.lower} and tell me how they burn."],
          "remind": ["Four {r1.site.lower}, in {r1}."],
          "done": ["Dimmer, all of them. Something is drawing them away.", "The trail of it leads into {r2}."]
        },
        {
          "id": "cold",
          "chapter": 1,
          "learned": "The {r2.ranged.lower} are not from {r2}: something sent them to guard the way.",
          "fieldNote": ["The last one falls, and the cold seems to lift a little."],
          "title": "Break the Guard",
          "goal": "Defeat 3 {r2.ranged.lower}",
          "hint": "{r2.ranged.plural} watch the way through {r2}. They strike from afar.",
          "where": { "zones": ["@r2"] },
          "unit": "{r2.ranged.lower}",
          "objective": { "t": "kill", "kind": "@r2.ranged", "count": 3, "zone": "@r2" },
          "reward": { "gold": 45, "xp": 60 },
          "offer": ["The way through {r2} is guarded. Break three of the {r2.ranged.lower}."],
          "remind": ["Three {r2.ranged.lower}, in {r2}."],
          "done": ["Then the way is open. And whatever set them there knows you are coming."]
        },
        {
          "id": "trace",
          "capabilities": { "guide": false },
          "chapter": 1,
          "learned": "The {r2.site.lower} lean toward {r3}, like flames in a draught.",
          "fieldNote": ["Three of them, all leaning the same way: toward {r3}."],
          "title": "Follow the Draught",
          "goal": "Touch 3 {r2.site.lower}",
          "hint": "Look for {r2.site.lower} in {r2}.",
          "where": { "zones": ["@r2"] },
          "unit": "{r2.site.lower}",
          "objective": { "t": "gather", "site": "@r2.site", "zone": "@r2", "count": 3 },
          "reward": { "gold": 45, "xp": 60, "items": ["elixir"] },
          "offer": ["The {r2.site.lower} of {r2} will show which way the light is flowing. Touch three."],
          "remind": ["Three {r2.site.lower}, in {r2}."],
          "done": ["{r3}. I should have known.", "Go by {r2~r3.way}, and go carefully."]
        },
        {
          "id": "brutes",
          "chapter": 2,
          "learned": "The {r3.brute.lower} were the mound's first guards, long before the lights.",
          "fieldNote": ["The third one crumbles, and the ground around the mound goes quiet."],
          "title": "The Guards of the Mound",
          "goal": "Defeat 3 {r3.brute.lower}",
          "hint": "{r3.brute.plural} guard {r3}.",
          "where": { "zones": ["@r3"] },
          "unit": "{r3.brute.lower}",
          "objective": { "t": "kill", "kind": "@r3.brute", "count": 3, "zone": "@r3" },
          "reward": { "gold": 70, "xp": 90 },
          "offer": ["Before you face what waits in {r3}, thin out its guards. Three {r3.brute.lower}."],
          "remind": ["Three {r3.brute.lower}, in {r3}."],
          "done": ["Now only the thing itself is left."]
        },
        {
          "id": "end",
          "chapter": 2,
          "learned": "The {r3.boss} was drinking the lights to stay awake. It sleeps now, for good.",
          "fieldNote": ["The {r3.boss} falls, and all across the land, the lights flare bright again."],
          "title": "Put Out the Dark",
          "goal": "Defeat the {r3.boss}",
          "hint": "The {r3.boss} waits in {r3}.",
          "where": { "zones": ["@r3"] },
          "unit": "foes",
          "objective": { "t": "kill", "kind": "@r3.boss", "count": 1, "zone": "@r3" },
          "reward": { "gold": 150, "xp": 150, "items": ["steelSword"] },
          "offer": ["The {r3.boss} is drinking the lights. End it, and they will burn again."],
          "remind": ["The {r3.boss}, in {r3}."],
          "done": [
            "The lights are back. I can see them from here, every one.",
            "Take this. You have earned more than a blade, but it is what I have."
          ]
        }
      ],
      "epilogue": [
        "The lights burn bright across the land again.",
        "Rest a while. When the road calls, you will hear it."
      ],
      "slots": [
        {},
        { "themes": ["frost", "swamp"] },
        { "themes": ["undead"], "foes": { "boss": { "tags": ["undead"] } } }
      ],
      "crossings": { "r2~r3": { "tags": ["restless-dead"] } },
      "keepers": ["ilsabet"]
    }
  },
  "pairings": {
    "rime_bog": {
      "regions": ["mirewood", "frostfen"],
      "tags": ["frost-creep"],
      "lore": {
        "way": "the old boardwalk where the bog of The Mirewood turns to ice and becomes The Frostfen",
        "sign": {
          "mirewood": "Frost has crept into the bog from The Frostfen: the reeds snap like glass and the pools skin over at noon.",
          "frostfen": "Warm mist rolls up from The Mirewood and freezes on the pines in ghostly shapes."
        }
      }
    },
    "corpse_lights": {
      "regions": ["mirewood", "barrow"],
      "tags": ["restless-dead"],
      "lore": {
        "way": "the sunken path that rises out of The Mirewood to the mound field of The Barrow",
        "sign": {
          "mirewood": "Corpse-lights drift down from The Barrow at dusk and hang over the bog, and the frogs fall silent.",
          "barrow": "Bog water from The Mirewood seeps up into the graves, and the dead do not like it."
        }
      }
    },
    "grave_frost": {
      "regions": ["frostfen", "barrow"],
      "tags": ["restless-dead", "cold"],
      "lore": {
        "way": "the frozen causeway between The Frostfen and the standing stones of The Barrow",
        "sign": {
          "frostfen": "The cold of The Barrow is in the ice here: it does not melt, even in full sun.",
          "barrow": "Rime from The Frostfen coats the standing stones, and the old names on them crack."
        }
      }
    }
  }
}
