{
  "name": "me-rpg",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm run map -- check && npm run sprites -- check && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tools && tsc --noEmit -p e2e && tsc --noEmit -p relay && tsc --noEmit -p server",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run map -- check && npm run sprites -- check",
    "map": "tsx tools/map/cli.ts",
    "ruins": "tsx tools/map/ruins.ts && prettier --write tools/map/ruinsAtlas.ts",
    "landmarks": "tsx tools/map/landmarks.ts && prettier --write src/systems/landmarkAtlas.ts",
    "tilesets": "tsx tools/map/recolor.ts && tsx tools/map/trees.ts && prettier --write tools/map/treeAtlas.ts && tsx tools/map/town.ts && tsx tools/map/interior.ts && tsx tools/map/crops.ts",
    "sprites": "tsx tools/sprites/cli.ts",
    "relay": "tsx tools/relay/dev-server.ts",
    "dm-bot": "tsx server/host.ts"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/crimson-text": "^5.3.0",
    "@huggingface/transformers": "^3.8.1",
    "kokoro-js": "^1.2.1",
    "pixi.js": "^8.22.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261011.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "~1.56.1",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "@typesafe-ai/sdk": "0.7.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
